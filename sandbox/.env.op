# Used by `op run --env-file .env.op` and by `just run` when secretspec is not
# configured. Copy to .env.op (gitignored) and point each name at a 1Password
# secret reference. Names must match agentSandbox.secrets in the VM flake.
#
GITHUB_PACKAGES_TOKEN=op://Personal/AgentGithubToken/password
AGENT_GITHUB_TOKEN=op://Personal/AgentGithubToken/password
COPILOT_GITHUB_TOKEN=op://Personal/AgentGithubCliToken/password
